<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Yojek — Pesan, Antar, Selesai</title>
<meta name="description" content="Yojek — pesan makanan atau barang di Bontang, kurir kami yang antar sampai ke depan pintu.">
<link rel="stylesheet" href="/Yojek/yojek-theme.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#fffafa;--surface:#fff;--text:#2f1717;--muted:#8b5e5e;
  --border:#fecaca;--border-strong:#fca5a5;
  --accent:#dc2626;--accent-2:#ef4444;--accent-light:#fca5a5;--accent-dim:#fef2f2;
  --success:#16a34a;--shadow:rgba(185,28,28,.12);
  --radius:16px;--radius-lg:22px;--header-height:69px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:var(--header-height)}
body{
  margin:0;color:var(--text);font-family:Inter,system-ui,sans-serif;line-height:1.6;
  -webkit-font-smoothing:antialiased;
  background:radial-gradient(circle at top right,rgba(252,165,165,.25),transparent 32%),linear-gradient(115deg,#fffafa 0%,#fff 52%,#fff1f2 100%);
}
main{overflow:clip}
img{max-width:100%;display:block}
button,a{font-family:inherit}
a{color:inherit;text-decoration:none}
.wrap{max-width:1180px;margin:0 auto;padding:0 24px}
@media(max-width:640px){.wrap{padding:0 18px}}

/* ---- Icons (self-contained, no external font/CDN) ---- */
.icon{width:1em;height:1em;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;vertical-align:-0.14em;flex:0 0 auto}

/* ---- Buttons ---- */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:9px;
  border-radius:12px;font-weight:800;font-size:15px;padding:13px 20px;
  cursor:pointer;border:0;min-height:48px;transition:transform .15s ease,filter .15s ease,box-shadow .15s ease,background .15s ease;
}
.btn:active{transform:translateY(1px)}
.btn-primary{background:linear-gradient(135deg,var(--accent),var(--accent-2) 58%,var(--accent-light));color:#fff;box-shadow:0 12px 26px var(--shadow)}
.btn-primary:hover{filter:brightness(1.05);box-shadow:0 16px 32px var(--shadow);transform:translateY(-1px)}
.btn-ghost{background:#fff;color:var(--text);border:1.5px solid var(--border)}
.btn-ghost:hover{border-color:var(--border-strong);background:var(--accent-dim);color:var(--accent)}
.btn-sm{padding:10px 16px;font-size:14px;min-height:40px;border-radius:10px}
.btn:focus-visible,a:focus-visible,button:focus-visible{outline:3px solid var(--accent-light);outline-offset:2px}

/* ---- Header ---- */
.site-header{
  position:sticky;top:0;z-index:50;background:rgba(255,255,255,.88);
  backdrop-filter:blur(10px);border-bottom:1px solid var(--border);
}
.site-header .row{display:flex;align-items:center;justify-content:space-between;padding:14px 0;gap:16px}
.brand{display:flex;align-items:center;gap:11px}
.brand-mark{width:46px;height:46px;border-radius:15px;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden;box-shadow:0 12px 26px rgba(222,29,122,.13)}
.brand-mark img{width:100%;height:100%;object-fit:contain;padding:5px}
.brand b{font-size:17px;letter-spacing:-.01em}
.brand span{display:block;font-size:11.5px;font-weight:700;color:var(--muted)}
.main-nav{display:flex;align-items:center;gap:6px}
.main-nav a{font-size:14.5px;font-weight:700;color:var(--muted);padding:9px 13px;border-radius:9px;transition:background .15s ease,color .15s ease}
.main-nav a:hover{color:var(--accent);background:var(--accent-dim)}
.header-actions{display:flex;align-items:center;gap:10px}
.icon-btn{width:40px;height:40px;border-radius:10px;border:1.5px solid var(--border);background:#fff;color:var(--muted);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:17px;transition:border-color .15s ease,color .15s ease}
.icon-btn:hover{border-color:var(--border-strong);color:var(--accent)}
.menu-toggle{display:none}
@media(max-width:860px){
  .main-nav{display:none}
  .menu-toggle{display:flex}
}

/* ---- Hero (single column, centered — no floating mockup) ---- */
.hero{position:relative;isolation:isolate;min-height:calc(100svh - var(--header-height));padding:clamp(40px,7vh,76px) 0;text-align:center;display:flex;align-items:center;background:url('/Yojek/bg-primary-optimized.jpg') center 42%/cover no-repeat;color:#fff}
.hero::before{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(47,23,23,.7),rgba(47,23,23,.48) 52%,rgba(47,23,23,.62))}
.hero::after{content:'';position:absolute;right:0;bottom:0;left:0;height:22%;z-index:0;background:linear-gradient(to bottom,rgba(255,250,250,0),rgba(255,250,250,.78) 72%,#fffafa 100%);pointer-events:none}
.hero-inner{position:relative;z-index:1;max-width:740px;margin:0 auto}
.hero-badge{
  display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.9);color:var(--accent);
  border-radius:999px;padding:8px 14px;font-size:13px;font-weight:800;margin-bottom:22px;
}
.hero h1{
  font-size:clamp(2.1rem,3.4vw + 1rem,3.35rem);line-height:1.08;font-weight:800;
  letter-spacing:-.02em;margin:0 auto 20px;max-width:16ch;color:#fff;
}
.hero p.lead{font-size:17.5px;color:#fff;max-width:46ch;margin:0 auto 30px}
.hero-ctas{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-bottom:38px}
.hero-stats{display:flex;gap:28px;flex-wrap:wrap;justify-content:center}
.hero-stats div b{display:block;font-size:22px;font-weight:800}
.hero-stats div b,.hero-stats div span{color:#fff}
.hero-stats div span{font-size:13px;font-weight:600;opacity:.86}

/* One simple, restrained animated moment: a courier dot travelling a
   dashed route from the store to the door. Loops slowly, one color,
   and stops entirely for reduced-motion. */
.hero-route{max-width:380px;margin:46px auto 0}
.hero-route .track{position:relative;height:2px;border-radius:999px;background:repeating-linear-gradient(90deg,var(--border-strong) 0 7px,transparent 7px 14px)}
.hero-route .dot{position:absolute;top:50%;width:13px;height:13px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px var(--accent-dim);transform:translate(-50%,-50%);animation:travel 3.6s ease-in-out infinite}
@keyframes travel{0%,100%{left:2%}50%{left:98%}}
.hero-route .labels{display:flex;justify-content:space-between;margin-top:12px;font-size:12.5px;font-weight:700;color:var(--muted)}
.hero-route .labels{color:rgba(255,255,255,.86)}
@media(prefers-reduced-motion:reduce){.hero-route .dot{animation:none;left:50%}}

/* ---- Section shell ---- */
.section{min-height:calc(100svh - var(--header-height));padding:clamp(44px,7vh,76px) 0;display:flex;align-items:center}
.section > .wrap{width:100%}
.section-head{max-width:640px;margin:0 0 clamp(28px,5vh,44px)}
.section-head h2{font-size:clamp(1.6rem,1.6vw + 1rem,2.15rem);font-weight:800;letter-spacing:-.01em;margin:0 0 12px}
.section-head p{color:var(--muted);font-size:16px;margin:0}
.section-alt{background:#fff}
.reveal{opacity:0;transform:translateY(28px);transition:opacity .65s ease,transform .65s cubic-bezier(.2,.7,.2,1)}
.reveal.is-visible{opacity:1;transform:translateY(0)}
.steps .reveal:nth-child(2),.features .reveal:nth-child(2){transition-delay:.08s}
.steps .reveal:nth-child(3),.features .reveal:nth-child(3){transition-delay:.16s}
.features .reveal:nth-child(4){transition-delay:.24s}

/* ---- Cara Kerja ---- */
.how-it-works{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(380px,.95fr);align-items:center;gap:clamp(40px,7vw,104px)}
.how-it-works .section-head{max-width:720px;margin-bottom:clamp(32px,5vh,48px)}
.how-it-works .section-head h2{font-size:clamp(2rem,2.2vw + 1rem,3rem);margin-bottom:16px}
.how-it-works .section-head p{font-size:18px;line-height:1.65}
.steps{display:grid;grid-template-columns:1fr;gap:18px}
.how-it-works-media{margin:0;min-height:560px;border-radius:var(--radius-lg);overflow:hidden;box-shadow:0 24px 55px rgba(74,20,20,.16);background:var(--accent-dim)}
.how-it-works-media img{width:100%;height:100%;min-height:560px;object-fit:cover}
@media(max-width:860px){
  .how-it-works{grid-template-columns:1fr;gap:36px}
  .steps{grid-template-columns:1fr}
  .how-it-works-media,.how-it-works-media img{min-height:340px}
}
.fast-delivery{
  position:relative;isolation:isolate;overflow:hidden;
  background:#fffafa url('/Yojek/bgyojek%20hal3.png') 24% center/cover no-repeat;
}
.fast-delivery::before{
  content:'';position:absolute;inset:0;z-index:-1;
  background:linear-gradient(90deg,rgba(255,250,250,.04) 0%,rgba(255,250,250,.12) 28%,rgba(255,250,250,.78) 61%,#fffafa 82%,#fffafa 100%);
}
.fast-delivery::after{
  content:'';position:absolute;inset:0;z-index:2;pointer-events:none;
  background:linear-gradient(180deg,#fff 0%,rgba(255,255,255,.94) 18px,rgba(255,255,255,0) 82px,rgba(255,255,255,0) calc(100% - 82px),rgba(255,255,255,.94) calc(100% - 18px),#fff 100%);
}
.fast-delivery-content{position:relative;z-index:3;display:grid;grid-template-columns:minmax(0,.78fr) minmax(420px,1.22fr);align-items:center;min-height:calc(100svh - var(--header-height));}
.fast-delivery-copy{grid-column:2;max-width:570px;margin-left:auto;padding:42px 0 42px 48px}
.fast-delivery-copy .eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--accent);font-size:13px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;margin-bottom:16px}
.fast-delivery-copy h2{max-width:12ch;margin:0 0 16px;font-size:clamp(2.2rem,3.5vw,3.7rem);line-height:1.04;letter-spacing:-.02em;text-shadow:0 2px 12px rgba(255,250,250,.95),0 1px 2px rgba(47,23,23,.18)}
.fast-delivery-copy > p{max-width:46ch;margin:0 0 28px;color:var(--muted);font-size:17px;line-height:1.7;text-shadow:0 1px 8px rgba(255,250,250,.98),0 1px 2px rgba(255,255,255,.8)}
.delivery-points{display:grid;gap:14px;max-width:500px}
.delivery-point{display:grid;grid-template-columns:42px 1fr;gap:14px;align-items:start}
.delivery-point .ic{width:42px;height:42px;border-radius:12px;background:#fff;color:var(--accent);display:flex;align-items:center;justify-content:center;box-shadow:0 8px 20px rgba(185,28,28,.1)}
.delivery-point h3{margin:0 0 3px;font-size:16px;text-shadow:0 1px 8px rgba(255,250,250,.98),0 1px 2px rgba(255,255,255,.8)}
.delivery-point p{margin:0;color:var(--muted);font-size:14px;line-height:1.5;text-shadow:0 1px 7px rgba(255,250,250,.98),0 1px 2px rgba(255,255,255,.8)}
@media(max-width:860px){
  .fast-delivery{background-position:center top;background-size:auto 58%;background-color:#fffafa;background-repeat:no-repeat}
  .fast-delivery::before{background:linear-gradient(180deg,rgba(255,250,250,.02) 0%,rgba(255,250,250,.08) 28%,#fffafa 54%,#fffafa 100%)}
  .fast-delivery-content{display:block;min-height:auto;padding-top:clamp(300px,58vw,440px)}
  .fast-delivery-copy{max-width:none;margin:0;padding:48px 0 16px}
  .fast-delivery-copy h2{max-width:16ch}
}
.step{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:24px 26px;display:grid;grid-template-columns:48px 1fr;column-gap:18px;align-items:start;transition:border-color .18s ease,transform .18s ease,box-shadow .18s ease}
.step:hover{border-color:var(--border-strong);transform:translateY(-3px);box-shadow:0 16px 32px rgba(74,20,20,.08)}
.step .num{width:44px;height:44px;border-radius:12px;background:var(--accent-dim);color:var(--accent);font-size:17px;font-weight:800;display:flex;align-items:center;justify-content:center;grid-row:span 2}
.step h3{margin:0 0 8px;font-size:19px;line-height:1.3}
.step p{margin:0;color:var(--muted);font-size:16px;line-height:1.55}

/* ---- Fitur (bento: one tall highlight + two regular + one wide) ---- */
.features{
  display:grid;gap:18px;
  grid-template-columns:1.25fr 1fr 1fr;
  grid-template-areas:"a b c" "a d d";
}
.features .feature:nth-child(1){grid-area:a}
.features .feature:nth-child(2){grid-area:b}
.features .feature:nth-child(3){grid-area:c}
.features .feature:nth-child(4){grid-area:d}
@media(max-width:860px){
  .features{grid-template-columns:1fr;grid-template-areas:"a" "b" "c" "d"}
}
.feature{padding:22px 20px;border-radius:var(--radius);border:1px solid var(--border);background:var(--surface);transition:border-color .18s ease,transform .18s ease,box-shadow .18s ease}
.feature:hover{border-color:var(--border-strong);transform:translateY(-3px);box-shadow:0 16px 32px rgba(74,20,20,.08)}
.feature .ic{width:40px;height:40px;border-radius:11px;background:var(--accent-dim);color:var(--accent);display:flex;align-items:center;justify-content:center;margin-bottom:14px;font-size:18px;flex:0 0 auto}
.feature h3{margin:0 0 6px;font-size:15.5px}
.feature p{margin:0;color:var(--muted);font-size:13.5px}

/* Highlight card: bigger, with a quiet decorative circle in the corner */
.feature.lg{padding:30px 26px;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:center;min-height:220px}
.feature.lg::after{content:'';position:absolute;right:-34px;bottom:-34px;width:150px;height:150px;border-radius:50%;background:var(--accent-dim);z-index:0}
.feature.lg .ic,.feature.lg h3,.feature.lg p{position:relative;z-index:1}
.feature.lg .ic{width:52px;height:52px;font-size:22px;margin-bottom:18px}
.feature.lg h3{font-size:19px}
.feature.lg p{font-size:14.5px;max-width:30ch}

/* Wide card: icon and text sit side by side */
.feature.wide{display:flex;align-items:center;gap:18px}
.feature.wide .ic{margin-bottom:0}
.feature.wide h3{margin:0 0 4px}

/* ---- Cerita perjalanan ---- */
.journey-section{position:relative;display:block;overflow:hidden;margin-top:-28px;padding-top:calc(clamp(64px,9vh,104px) + 28px);padding-bottom:clamp(64px,9vh,104px);background:linear-gradient(180deg,#fff 0%,#fff 12%,#fff5f5 24%,#fee2e2 38%,#fecaca 53%,#fca5a5 68%,#fecaca 84%,#fff1f2 95%,#fff 100%)}
.journey-section::before{content:'';position:absolute;top:-40px;left:50%;z-index:0;width:100vw;height:150px;transform:translateX(-50%);pointer-events:none;background:linear-gradient(180deg,#fff 0%,#fff 28%,rgba(255,255,255,.92) 52%,rgba(255,255,255,.48) 76%,rgba(255,255,255,0) 100%)}
.journey-head{position:relative;z-index:1;max-width:620px;margin:0 auto clamp(34px,5vh,52px);text-align:center}
.journey-head h2{margin:0 0 12px;font-size:clamp(1.7rem,1.8vw + 1rem,2.4rem);font-weight:800;letter-spacing:-.01em}
.journey-head p{margin:0;color:var(--muted);font-size:16px}
.journey-viewport{position:relative;z-index:1;overflow-x:auto;overflow-y:hidden;padding:14px calc((100vw - min(68vw,760px)) / 2) 30px;cursor:grab;scroll-snap-type:x mandatory;scrollbar-color:var(--accent-light) transparent;scrollbar-width:thin;user-select:none}
.journey-viewport.is-dragging{cursor:grabbing;scroll-snap-type:none}
.journey-track{display:flex;align-items:center;gap:28px;width:max-content}
.journey-card{width:min(68vw,760px);margin:0;scroll-snap-align:center;flex:0 0 auto;transition:transform .55s cubic-bezier(.2,.75,.25,1),opacity .55s ease,filter .55s ease}
.journey-card img{width:100%;aspect-ratio:1.45;object-fit:cover;border-radius:var(--radius-lg);box-shadow:0 24px 58px rgba(127,29,29,.2);pointer-events:none;filter:grayscale(72%);opacity:.42;transition:filter .55s ease,opacity .55s ease,box-shadow .55s ease}
.journey-card:not(.is-active){transform:scale(.88)}
.journey-card.is-active{transform:scale(1);z-index:1}
.journey-card.is-active img{filter:grayscale(0);opacity:1;box-shadow:0 28px 64px rgba(127,29,29,.28)}
.journey-card figcaption{padding:14px 4px 0;color:var(--muted);font-size:14px;font-weight:700}
@media(max-width:640px){
  .journey-viewport{padding-right:calc((100vw - 86vw) / 2);padding-left:calc((100vw - 86vw) / 2)}
  .journey-card{width:86vw}
}

/* ---- CTA band ---- */
.cta-band{
  background:linear-gradient(135deg,var(--accent) 0%,var(--accent-2) 56%,var(--accent-light) 100%);
  border-radius:28px;padding:52px 44px;color:#fff;text-align:center;
  box-shadow:0 24px 60px var(--shadow);
}
.cta-band h2{margin:0 0 12px;font-size:clamp(1.5rem,1.8vw + 1rem,2rem);font-weight:800}
.cta-band p{margin:0 0 26px;color:#fff1f1;font-size:15.5px}
.cta-band .hero-ctas{justify-content:center;margin-bottom:0}
.cta-band .btn-primary{background:#b91c1c;color:#fff;box-shadow:none}
.cta-band .btn-primary:hover{filter:none;background:#991b1b}
.cta-section{min-height:calc(82svh - var(--header-height));background:#fffafa}

/* ---- Footer ---- */
.site-footer{border-top:1px solid rgba(255,255,255,.18);padding:52px 0 28px;background:linear-gradient(125deg,#b91c1c 0%,#7f1d1d 56%,#252525 100%);color:#fff}
.footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:32px;margin-bottom:36px}
@media(max-width:720px){.footer-grid{grid-template-columns:1fr 1fr}}
.footer-grid h4{font-size:13px;font-weight:800;color:#fff;margin:0 0 14px}
.footer-grid ul{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.footer-grid ul a{display:inline-block;font-size:14px;font-weight:600;color:#fff;transition:color .15s ease,transform .15s ease}
.footer-grid ul a:hover{color:#fecaca;transform:translateY(-3px)}
.site-footer > .wrap > .footer-grid > div > p{color:rgba(255,255,255,.82)!important}
.footer-bottom{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;padding-top:22px;border-top:1px solid rgba(255,255,255,.22);font-size:13px;color:rgba(255,255,255,.82)}

/* ---- Login modal ---- */
dialog#loginModal{border:0;border-radius:22px;padding:0;width:min(92vw,420px);box-shadow:0 30px 70px rgba(74,20,20,.28)}
dialog#loginModal::backdrop{background:rgba(47,23,23,.42)}
.modal-inner{padding:26px}
.modal-inner .m-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px}
.modal-inner h3{margin:0;font-size:18px}
.modal-inner p{margin:6px 0 20px;color:var(--muted);font-size:14px}
.close-x{border:0;background:transparent;color:var(--muted);font-size:17px;cursor:pointer;padding:4px;transition:color .15s ease;display:flex}
.close-x:hover{color:var(--accent)}
.role-pick{display:grid;gap:10px}
.role-pick a{display:flex;align-items:center;gap:13px;border:1.5px solid var(--border);border-radius:14px;padding:13px 14px;transition:border-color .15s ease,background .15s ease}
.role-pick a:hover{border-color:var(--accent);background:var(--accent-dim)}
.role-pick .ic{width:40px;height:40px;border-radius:11px;background:var(--accent-dim);color:var(--accent);display:flex;align-items:center;justify-content:center;flex:0 0 auto;font-size:18px}
.role-pick b{display:block;font-size:14.5px}
.role-pick span{font-size:12.5px;color:var(--muted)}

/* ---- Mobile nav sheet ---- */
#mobileNav{position:fixed;inset:0;z-index:60;background:rgba(47,23,23,.4);display:none}
#mobileNav.open{display:block}
#mobileNav .sheet{position:absolute;top:0;right:0;bottom:0;width:min(80vw,320px);background:#fff;padding:20px;display:flex;flex-direction:column;gap:6px;box-shadow:-16px 0 40px rgba(0,0,0,.15)}
#mobileNav a{padding:13px 12px;border-radius:10px;font-weight:700;color:var(--text);transition:background .15s ease,color .15s ease}
#mobileNav a:hover{background:var(--accent-dim);color:var(--accent)}
@media(max-width:860px){
  html{scroll-padding-top:0}
  .hero,.section,.cta-section{min-height:auto;display:block}
  .hero{padding:64px 0 76px}
  .section{padding:64px 0}
  .cta-section{padding:64px 0}
  .hero{background-position:center top}
}
@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .reveal{opacity:1;transform:none;transition:none}
}
</style>
</head>
<body>

<!-- Self-contained icon sprite: no external font/CDN, renders everywhere. -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></symbol>
    <symbol id="i-close" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></symbol>
