<script>
const revealItems=document.querySelectorAll('.reveal');
const revealObserver=new IntersectionObserver((entries,observer)=>{
  entries.forEach(entry=>{
    entry.target.classList.toggle('is-visible',entry.isIntersecting);
  });
},{threshold:.14,rootMargin:'0px 0px -40px'});
revealItems.forEach(item=>revealObserver.observe(item));

const mobileNav=document.getElementById('mobileNav');
document.getElementById('menuToggle').addEventListener('click',()=>mobileNav.classList.add('open'));
document.getElementById('mobileNavClose').addEventListener('click',()=>mobileNav.classList.remove('open'));
mobileNav.addEventListener('click',e=>{if(e.target===mobileNav)mobileNav.classList.remove('open');});
document.querySelectorAll('#mobileNav a').forEach(a=>a.addEventListener('click',()=>mobileNav.classList.remove('open')));

const journeyViewport=document.getElementById('journeyViewport');
const journeyCards=[...journeyViewport.querySelectorAll('.journey-card')];
let journeyDragging=false;
let journeyStartX=0;
let journeyStartScroll=0;
let journeyFrame=0;
const updateJourneyActive=()=>{
  const viewportCenter=journeyViewport.getBoundingClientRect().left+journeyViewport.clientWidth/2;
  let closestCard=null;
  let closestDistance=Infinity;
  journeyCards.forEach(card=>{
    const box=card.getBoundingClientRect();
    const distance=Math.abs(box.left+box.width/2-viewportCenter);
    if(distance<closestDistance){closestDistance=distance;closestCard=card;}
  });
  journeyCards.forEach(card=>card.classList.toggle('is-active',card===closestCard));
};
journeyViewport.addEventListener('scroll',()=>{
  cancelAnimationFrame(journeyFrame);
  journeyFrame=requestAnimationFrame(updateJourneyActive);
},{passive:true});
journeyViewport.addEventListener('wheel',event=>{
  if(event.shiftKey){
    event.preventDefault();
    journeyViewport.scrollBy({left:event.deltaY||event.deltaX,behavior:'smooth'});
  }
},{passive:false});
journeyViewport.addEventListener('pointerdown',event=>{
  if(event.button!==1)return;
  journeyDragging=true;
  journeyStartX=event.clientX;
  journeyStartScroll=journeyViewport.scrollLeft;
  journeyViewport.classList.add('is-dragging');
  journeyViewport.setPointerCapture(event.pointerId);
  event.preventDefault();
});
journeyViewport.addEventListener('pointermove',event=>{
  if(!journeyDragging)return;
  journeyViewport.scrollLeft=journeyStartScroll-(event.clientX-journeyStartX);
});
journeyViewport.addEventListener('pointerup',event=>{
  journeyDragging=false;
  journeyViewport.classList.remove('is-dragging');
  journeyViewport.releasePointerCapture(event.pointerId);
});
journeyViewport.addEventListener('pointercancel',()=>{
  journeyDragging=false;
  journeyViewport.classList.remove('is-dragging');
});
window.addEventListener('load',()=>{
  const middleCard=journeyCards[1];
  journeyViewport.scrollLeft=middleCard.offsetLeft-(journeyViewport.clientWidth-middleCard.offsetWidth)/2;
  updateJourneyActive();
});
</script>
